# The Actlet image with a shell, for the Kubernetes test's agent task: the
# distroless image has no shell for the agent's shell tool.
#
#   docker build -t actlet-tools:dev --build-arg BASE=actlet:dev test/k8s
ARG BASE=actlet:dev
FROM ${BASE} AS actlet

FROM busybox:1.36
COPY --from=actlet /usr/local/bin/actlet /usr/local/bin/actlet
RUN mkdir -p /var/lib/actlet && chown 65532:65532 /var/lib/actlet
WORKDIR /var/lib/actlet
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/actlet"]
CMD ["help"]
